# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DB_PATH=./data/coralink.db
LOG_LEVEL=info

# Authentication. In production both values are mandatory and must be at
# least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-jwt-secret
AUTH_PEPPER=replace-with-a-long-random-auth-pepper

# Development convenience: returns devCode from /auth/request-code and logs it.
# Automatically disabled when NODE_ENV=production.
DEV_MODE=true

# Comma-separated origins, or * for local development.
ALLOWED_ORIGINS=*

# Offline message retention.
MESSAGE_TTL_DAYS=30

# Maximum concurrent WebSocket connections per user.
WS_MAX_CONNECTIONS=3
